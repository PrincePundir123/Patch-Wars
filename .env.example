NODE_ENV=development
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DEMO_MODE=true
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5173/auth/twitch/callback
# Separate Twitch Extension settings (not the OAuth app secret). Optional.
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=
# Enable only after Twitch Extension onboarding/catalog verification. Never use a demo receipt.
PAID_DEPLOYMENTS_ENABLED=false
# The Extension's OAuth client secret, not its base64 JWT signing secret above.
TWITCH_EXTENSION_CLIENT_SECRET=
# Keep this file on persistent local storage; one server process per database.
PAYMENTS_DB_PATH=.data/payments.sqlite
# Public HTTPS origin used by the uploaded extension to reach this server.
EXTENSION_BACKEND_URL=
# Required to create a live match; generate a long random value locally.
ADMIN_KEY=
FORGE_PROVIDER=fixture
FORGE_TIMEOUT_MS=90000
FORGE_MAX_JOBS_PER_HOUR=12
OPENAI_API_KEY=
FORGE_MODEL=gpt-4.1-mini
# Codex is disabled unless an operator verifies OS-level isolation; see docs/security.md.
CODEX_ISOLATED=false
LOG_LEVEL=info
# Optional free local AI provider; run ollama list to find an installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

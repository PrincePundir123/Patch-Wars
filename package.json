{
  "name": "patch-wars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx scripts/build-worker.ts",
    "pretest": "tsx scripts/build-worker.ts",
    "dev": "concurrently -k -n server,web \"tsx watch apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server/index.js",
    "evaluate": "tsx scripts/evaluate.ts",
    "soak": "tsx scripts/soak.ts",
    "verify:local-ai": "tsx scripts/verify-local-ai.ts",
    "doctor": "tsx scripts/doctor.ts",
    "profile:ui": "tsx scripts/profile-ui.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.0.2",
    "@openai/codex-sdk": "^0.77.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "pixi.js": "^8.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "ws": "^8.18.2",
    "zod": "^4.6.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
